# Dockerfile para bajo consumo de CPU y RAM usando Alpine
FROM alpine:latest

# Instalar el paquete 'stress-ng' en Alpine
RUN apk add --no-cache stress-ng

# Comando para consumir menos CPU y RAM en un bucle infinito
CMD ["sh", "-c", "while true; do stress-ng --cpu 1 --vm 1 --vm-bytes 128M > /dev/null 2>&1; sleep 5; done"]
