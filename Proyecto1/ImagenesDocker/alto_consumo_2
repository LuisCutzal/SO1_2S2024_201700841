# Dockerfile para muy bajo consumo de CPU y RAM usando Alpine
FROM alpine:latest

# Instalar el paquete 'stress-ng' en Alpine
RUN apk add --no-cache stress-ng

# Ejecutar stress-ng en un bucle infinito
CMD ["sh", "-c", "while true; do stress-ng --cpu 1 --vm 1 --vm-bytes 32M > /dev/null 2>&1; sleep 5; done"]
